/* ------------------------------------------------------------------------------------------------------------------ */
/* The grammar specification for the Diorite mathematics computing language.                                          */
/* Whitespace is implied by this grammar (unless specified or enforced otherwise)                                     */
/* ------------------------------------------------------------------------------------------------------------------ */

/* fundamental types */
<digit>         ::= "1"|"2"|"3"|"4"|"5"|"6"|"7"|"8"|"9"|"0"

<digits>        ::= <digit>
                 |  <digit> <digits>

<letter>        ::= "a"|"b"|"c"|"d"|"e"|"f"|"g"|"h"|"i"|"j"|"l"|"m"|"n"|"o"|"p"|"q"|"r"|"s"|"t"|"u"|"v"|"w"|"x"|"y"|"z"
                 |  "A"|"B"|"C"|"D"|"E"|"F"|"G"|"H"|"I"|"J"|"L"|"M"|"N"|"O"|"P"|"Q"|"R"|"S"|"T"|"U"|"V"|"W"|"X"|"Y"|"Z"

<letters>       ::= <letter>
                 |  <letter> <letters>

<number>        ::= <digits>
                 |  <digits> "." <digits>

<identifier>    ::= <letter>
                 |  <letter> <digit>

<eoi>           ::= ";"
                 |  ";" <eoi>

/* new */
<program>       ::= ε
                 |  <statement> <program>

/* statement */
<statement>     ::= ";"
                 |  <expression> ";"
                 |  <identifier>  "=" <expression> ";"
                 |  <functiondef> "=" <functionbody>

/* expressions */
<expression>     ::= <term> <expression'>

<expression'>    ::= ε
                  |  "+" <term> <expression'>
                  |  "-" <term> <expression'>

<term>           ::= <factor> <term'>

<term'>          ::= ε
                  |  "*"  <factor> <term'>
                  |  "/"  <factor> <term'>
                  |  "//" <factor> <term'>
                  |  "%"  <factor> <term'>

<factor>         ::= <signed>
                  |  <signed> "^" <signed>

<signed>         ::= <exponent>
                  |  "+" <signed>
                  |  "-" <signed>

<exponent>       ::= <subexpression> <exponent'>

<exponent'>      ::= ε
                  |  "!" <exponent'>

<subexpression>  ::= <value>
                  |  "(" <expression> ")"
                  |  "|" <expression> "|"
                  |  <identifier> "(" <args> ")"
                  |  <letters>    "(" <args> ")"

<args>           ::= <expression>
                  |  <expression> "," <args>

<value>          ::= "undefined"
                  |  "infinity" | "inf"
                  |  "pi"
                  |  "tau"
                  |  "euler"
                  |  <letters> <digit>
                  |  <number>

/* functions */
<functiondef>    ::= <functionmeta> <identifier> "(" <functionparams> ")" <functionreturn>

<functionmeta>   ::= ε
                  |  "[" "inlined"  "]"             <functionmeta>
                  |  "[" "memoized" "]"             <functionmeta>
                  |  "[" "symbol" ":" <letters> "]" <functionmeta>

<functionparams> ::= <functionparam>
                  |  <functionparam> "," <functionparams>

<functionparam>  ::= <identifier>
                  |  <identifier> ":" "N"
                  |  <identifier> ":" "Z"
                  |  <identifier> ":" "R"
                  |  <identifier> ":" "Q"
                  |  <identifier> ":" "I"
                  |  <identifier> ":" "C"

<functionreturn> ::= ε
                  |  "->" "N"
                  |  "->" "Z"
                  |  "->" "R"
                  |  "->" "Q"
                  |  "->" "I"
                  |  "->" "C"

<functionbody>   ::= <expression> ";"
                  |  "{" <conditions> "}"

/* conditions */
<conditions>     ::= <ifcond> ";" <conditions>
                  |  <ifcond> ";" <otherwisecond> ";"

<ifcond>         ::= <expression> "if" <expression> <comparison> <expression>

<otherwisecond>  ::= <expression> "otherwise"

<comparison>     ::= "="
                  |  "!="
                  |  "<"
                  |  "<="
                  |  ">"
                  |  ">="

