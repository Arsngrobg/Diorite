/*                                                                                                                    */
/* ------------------------------------------------------------------------------------------------------------------ */
/* The grammar specification for the Diorite mathematics computing language.                                          */
/* It models both the tokens in the lexer and the parsing stages in the parser                                        */
/* Each stag eof the parser should be read from bottom-up (hence this grammar starts at the <Parse> rule              */
/* This grammar was written using the 'BNF Plaground' tool: https://bnfplayground.pauliankline.com                    */
/* Whitespace is implied by this grammar (unless specified or enforced otherwise                                      */
/* The raw character 'E' denotes epsilon (ε) an empty string                                                          */
/* ------------------------------------------------------------------------------------------------------------------ */

/* Tokens ----------------------------------------------------------------------------------------------------------- */

/* value types */
<Number>             ::= [0-9]+ ("." [0-9]+)?

<Identifier>         ::= ([a-z] | [A-Z])
                      |  ([a-z] | [A-Z]) [0-9]

<Symbol>             ::= ([a-z] | [A-Z]) ([a-z] | [A-Z])+

/* constants */
<Undefined>          ::= "undefined"
<Infinity>           ::= "infinity" | "inf"
<Pi>                 ::= "pi"
<Tau>                ::= "tau"
<Euler>              ::= "euler"

/* operators */
<Tick>               ::= "'"
<Comma>              ::= ","
<Colon>              ::= ":"
<Arrow>              ::= "->"
<Equals>             ::= "="
<LessThan>           ::= "<"
<GreaterThan>        ::= ">"
<LessThanOrEqual>    ::= "<="
<GreaterThanOrEqual> ::= ">="
<NotEqual>           ::= "!="
<Hat>                ::= "^"
<Exclamation>        ::= "!"
<Asterisk>           ::= "*"
<Slash>              ::= "/"
<Percentage>         ::= "%"
<Plus>               ::= "+"
<Hyphen>             ::= "-"
<Bar>                ::= "|"

/* control flow */
<If>                 ::= "if"
<Otherwise>          ::= "otherwise"

/* parenthesis, brackets, and braces */
<LeftParenthesis>    ::= "("
<RightParenthesis>   ::= ")"
<LeftBracket>        ::= "["
<RightBracket>       ::= "]"
<LeftBrace>          ::= "{"
<RightBrace>         ::= "}"

/* ------------------------------------------------------------------------------------------------------------------ */

/* Parse ------------------------------------------------------------------------------------------------------------ */
<Value>         ::= <Undefined>
                 |  <Infinity>
                 |  <Pi>
                 |  <Tau>
                 |  <Euler>
                 |  <Identifier>
                 |  <Number>

<Param>         ::= <Identifier>
                 |  <Identifier> <Colon> <Identifier>

<Params>        ::= <Param>
                 |  <Param> <Comma> <Params>

<Return>        ::= E
                 |  <Arrow> <Identifier>

<Args>          ::= <Expression>
                 |  <Expression> <Comma> <Args>

<Attributes>    ::= E
                 |  <LeftBracket> <Symbol>                  <RightBracket> <Attributes>
                 |  <LeftBracket> <Symbol> <Colon> <Symbol> <RightBracket> <Attributes>

<Define>        ::= <Attributes> <Identifier> <LeftParenthesis> <Params> <RightParenthesis> <Return>

<Condition>     ::= <Expression> <If> <Expression>
                   (<Equals> | <NotEqual> | <GreaterThan> | <LessThan> | <GreaterThanOrEqual> | <LessThanOrEqual>)
                   <Expression> <Condition>
                 |  <Expression> <Otherwise>

<Body>          ::= <Expression>
                 |  <LeftBrace> <Condition> <RightBrace>

/* sub-expression -> value -> symbolic application -> value application */
<Atom>          ::= <LeftParenthesis> <Expression> <RightParenthesis>
                 |  <Bar>             <Expression> <Bar>
                 |  <Value>
                 |  <Symbol>     <LeftParenthesis> <Args> <RightParenthesis>
                 |  <Identifier> <LeftParenthesis> <Args> <RightParenthesis>

<Differential>  ::= <Atom>
                 |  <Integral> <Tick>

<Integral>      ::= <Differential>
                 |  <Tick> <Differential>

<Exponent>      ::= <Integral>
                 |  <Factor> <Hat> <Exponent>

<Factor>        ::= <Exponent>
                 |  <Factor> <Exclamation>

<Term>          ::= <Factor>
                 |  <Factor> (<Asterisk> | <Slash> | <Percentage>) <Term>

<Expression>    ::= <Term>
                 |  <Term> (<Plus> | <Hyphen>) <Expression>

<Equation>      ::= <Define>     <Equals> <Body>
                 |  <Expression> <Equals> <Expression>

<Parse>         ::= <Expression>
                 |  <Equation>

/* ------------------------------------------------------------------------------------------------------------------ */

