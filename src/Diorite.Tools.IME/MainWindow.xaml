<Window x:Class="IME.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Diorite"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/> <!-- Left section (inputs): 40% -->
            <ColumnDefinition Width="1"/> <!-- Vertical divider: 1px -->
            <ColumnDefinition Width="7*"/> <!-- Right section (graph): 60% -->
        </Grid.ColumnDefinitions>
        <!-- Inputs -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Plot label -->
                <RowDefinition Height="3*"/> <!-- Plot space -->
                <RowDefinition Height="Auto"/> <!-- Result label -->
                <RowDefinition Height="Auto"/> <!-- Result box -->
                <RowDefinition Height="Auto"/> <!-- Divider -->
                <RowDefinition Height="Auto"/> <!-- Workspace label and buttons -->
                <RowDefinition Height="3*"/> <!-- Workspace -->
            </Grid.RowDefinitions>
            <!-- Plot -->
            <TextBlock Text="Plot:" FontSize="24"
                       FontFamily="Calibri" FontWeight="Bold"
                       Margin="0,0,0,6" Grid.Row="0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                <StackPanel x:Name="InputPanel" Orientation="Vertical"/>
            </ScrollViewer>
            <!-- Result -->
            <TextBlock Text="Result:" FontSize="24"
                       FontFamily="Calibri" FontWeight="Bold"
                       Margin="0,12,0,6" Grid.Row="2"/>
            <TextBox x:Name="Output" IsReadOnly="True" 
                     FontFamily="Calibri" FontSize="24" 
                     Height="64" Padding="12" 
                     FontStyle="Italic" TextWrapping="Wrap" 
                     BorderBrush="Black" VerticalContentAlignment="Center" Grid.Row="3"/>
            <!-- Divider -->
            <Border Height="1" Background="Black" Margin="0,20,0,20" Grid.Row="4"/>
            <!-- Workspace -->
            <DockPanel Grid.Row="5" Grid.RowSpan="2" LastChildFill="True" Margin="0,0,0,0">
                <!-- Label and file name -->
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Workspace:" FontSize="24"
                               FontFamily="Calibri" FontWeight="Bold"/>
                    <TextBlock x:Name="WorkspaceFileName" Text="File:"
                               FontSize="16" FontFamily="Calibri"
                               FontStyle="Italic" Foreground="Gray"
                               Margin="0,0,0,0"/>
                </StackPanel>
                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,6">
                    <Button Content="Run" Width="80" Height="32" Margin="0,0,6,0" Click="RunClick"/>
                    <Button Content="Save" Width="80" Height="32" Margin="0,0,6,0" Click="SaveFileClick"/>
                    <Button Content="Save As" Width="80" Height="32" Margin="0,0,6,0" Click="SaveAsClick"/>
                    <Button Content="Load" Width="80" Height="32" Margin="0,0,6,0" Click="LoadFileClick"/>
                    <Button Content="Clear" Width="80" Height="32" Click="ClearClick"/>
                </StackPanel>
                <!-- Editor or REPL -->
                <avalonEdit:TextEditor
                    x:Name="Workspace" ShowLineNumbers="True"
                    FontFamily="Calibri" FontSize="16"
                    Background="White" Foreground="Black"
                    Padding="4" BorderBrush="Black"
                    BorderThickness="1" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
        <!-- Divider -->
        <Border Grid.Column="1" Background="Black" Width="1"/>
        <!-- Graph -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Help button -->
                <RowDefinition Height="*"/> <!-- Plot -->
            </Grid.RowDefinitions>
            <Button Content="Help" Width="100" FontSize="24" Height="40" Click="HelpClick"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Grid.Row="0"/>
            <TextBlock Text="Diorite Mathematics Interpreter" Margin="0,20,0,0"
                FontFamily="Calibri"
                FontSize="40" FontWeight="Bold"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <scottPlot:WpfPlot x:Name="plot" Margin="20" Grid.Row="1"/>
        </Grid>
        <!-- Help -->
        <Grid Grid.ColumnSpan="3" x:Name="HelpMenu" Visibility="Collapsed" Panel.ZIndex="1">
            <Border Background="#40000000"/>
            <Border Background="White" Padding="20" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    BorderBrush="Black" BorderThickness="1"
                    MaxHeight="1000" MaxWidth="1200" Width="Auto" Height="Auto">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel x:Name="HelpContentPanel" Margin="0,0,10,0">
                        <DockPanel Margin="0,0,-10,10">
                            <Button Content="Close" Click="CloseHelpClick"
                                    FontSize="24" FontFamily="Calibri"
                                    Width="100" Height="32"
                                    Padding="2,0" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                            <TextBlock x:Name="HelpHeader" Text="Help"
                                       FontFamily="Calibri" FontSize="24" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>