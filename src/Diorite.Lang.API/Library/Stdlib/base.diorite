[symbol:abs]
f(x : R) -> R = {
    -x if x < 0; x otherwise;
}

[symbol:sign]
f(x : R) -> R = {
    -1.0 if x < 0.0;
    0.0 if x = 0.0; 1.0 otherwise;
}

[symbol:sum]
f(n: N) -> N = n * (n + 1) / 2;

[symbol:floor]
f(x : R) -> R = {
    # Truncating with integer division
    x // 1 if x >= 0;
    (x // 1) - 1 if x % 1 != 0; 
    x // 1 otherwise;
}

[symbol:ceil]
f(x : R) -> R = {
    # Truncating with integer division
    x // 1 if x <= 0; 
    (x // 1) + 1 if x % 1 != 0; 
    x // 1 otherwise;
}

[symbol:gcd]
f(a : Z, b : Z) -> Z = {
    abs(a) if b = 0; gcd(b, a % b) otherwise;
}

[symbol:lcm]
f(a : Z, b : Z) -> Z = abs(a * b) / gcd(a, b);

# x is the number sqrt is applied to
# a is current sqrt value
# n is iteration index
[symbol:newton_raphson]
f(x : R, a : R, n : Z) -> R = {
    a if n >= 10;
    newton_raphson(
        x,
        0.5 * (a + x / a),
        n + 1
    ) otherwise;
}

[symbol:sqrt]
f(x : R) -> C = {
    0.0 if x = 0.0;
    newton_raphson(x, x * 0.5, 0) if x > 0.0;
    complex(0, sqrt(-x)) otherwise;
}