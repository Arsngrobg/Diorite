[symbol:abs]
f(x : Z) -> Z = {
    -x if x < 0; x otherwise;
}

[symbol:sign]
f(x : R) -> R = {
    -1.0 if x < 0.0;
    0.0 if x = 0.0; 1.0 otherwise;
}

[symbol:floor]
f(x : R) -> R = {
    # Truncating with integer division
    x // 1 if x >= 0;
    (x // 1) - 1 if x % 1 != 0; 
    x // 1 otherwise;
}

[symbol:ceil]
f(x : R) -> R = {
    # Truncating with integer division
    x // 1 if x <= 0; 
    (x // 1) + 1 if x % 1 != 0; 
    x // 1 otherwise;
}

[symbol:deg]
f(r : R) -> R = r * (180.0 / pi);

[symbol:rad]
f(d : R) -> R = d * (pi / 180.0);

[symbol:gcd]
f(a : Z, b : Z) -> Z = {
    abs(a) if b = 0; gcd(b, a % b) otherwise;
}

[symbol:lcm]
f(a : Z, b : Z) -> Z = abs(a * b) / gcd(a, b);