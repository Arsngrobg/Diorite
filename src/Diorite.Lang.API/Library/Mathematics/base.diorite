abs(x : Z) -> Z = {
    -x if x < 0; x otherwise;
}

sign(x : R) -> R = {
    -1.0 if x < 0.0;
    0.0 if x = 0.0; 1.0 otherwise;
}

floor(x : R) -> R = {
    # Truncating with integer division
    x // 1 if x >= 0;
    (x // 1) - 1 if x % 1 != 0; 
    x // 1 otherwise;
}

ceil(x : R) -> R = {
    # Truncating with integer division
    x // 1 if x <= 0; 
    (x // 1) + 1 if x % 1 != 0; 
    x // 1 otherwise;
}

deg(r : R) -> R = r * (180.0 / pi);

rad(d : R) -> R = d * (pi / 180.0);

gcd(a : Z, b : Z) -> Z = {
    abs(a) if b = 0; gcd(b, a % b) otherwise;
}

lcm(a : Z, b : Z) -> Z = abs(a * b) / gcd(a, b);